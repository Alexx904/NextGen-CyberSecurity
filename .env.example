# ========================================================
# NextGen CyberSecurity Platform - Environment Configuration
# ========================================================

# Server Configuration
PORT=8080
FRONTEND_PORT=3000
APP_ENV=development

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_USER=nextgen
DB_PASSWORD=nextgen_secret_pwd
DB_NAME=nextgen_cybersec
DB_SSLMODE=disable

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-change-in-production-min32chars
JWT_EXPIRATION_MINUTES=60
